# Example environment configuration for Docker Traffic Monitor
# Copy this file to .env and adjust values as needed.

# Bind address for the web UI and API
HOST=0.0.0.0

# HTTP port for the dashboard
PORT=8000

# Poll interval in seconds
POLL_INTERVAL=30

# Directory where SQLite data is stored
DATA_DIR=/data

# Docker socket path (default for Linux hosts)
DOCKER_SOCKET=/var/run/docker.sock
